.DS_Store
.idea
.build
*.old
.kiro/*
# ignore the lock file
website/package-lock.json

# Local .terraform directories
**/.terraform/*
**/_local

# Ignore _local folders under blueprints
blueprints/**/_local/

# Terraform lockfile
.terraform.lock.hcl

# .tfstate files
*.tfstate
*.tfstate.*
*.tfplan

terraform-apply.log

# Crash log files
crash.log

# Exclude all .tfvars files, which are likely to contain sentitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
!blueprints/**/*.tfvars
!data-stacks/**/*.tfvars

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Locals
kubeconfig*
kube-config*
local_tf_state/
.vscode
.gitallowed
site
.env*

# Checks
.tfsec

# venv
**/.venv/*
**/venv/*
**/__pycache__/*

# gradio
**/gradio_cached_examples

# node modules
node_modules
gen-ai/inference/stable-diffusion-rayserve-gpu/locust/__pycache__/*
website/package-lock.json
website/package.json

# spark-on-eks deploy.sh saved settings (per deployment)
.deploy-params.env
# spark-on-eks VPC configs (account-specific VPC/subnet IDs)
data-stacks/spark-on-eks/vpc*.json
# spark-on-eks cleanup.sh run logs and Terraform state backups (contain account/IAM identifiers)
data-stacks/spark-on-eks/cleanup-*.log
data-stacks/spark-on-eks/state-backup-*
data-stacks/spark-on-eks/.cleanup.lock/
# spark-on-eks environment-specific working notes (account, VPC, subnet and endpoint IDs)
data-stacks/spark-on-eks/instructions.md
